<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Este proyecto no usa ningún paquete NuGet externo (ver el comentario en el .csproj),
    así que desactivamos las fuentes remotas para poder compilar sin internet aquí en el
    sandbox. Cuando lo abras en Visual Studio 2022, puedes borrar este archivo (o dejarlo,
    no hace daño) y todo sigue funcionando normal con nuget.org disponible.
  -->
  <packageSources>
    <clear />
  </packageSources>
</configuration>
